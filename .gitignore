# Binaries. Anchored to the repository root on purpose: an unanchored "cortex"
# also matches the cmd/cortex/ directory, which silently kept the program's
# entrypoint out of the published repository.
/bin/
/dist/
/cortex
/cortex.exe

# Test artifacts
*.out
*.test
coverage.*
.cortex/cache/
.cortex/baseline.sarif
results/
# Scan output, not the golden files the SARIF codec is tested against.
/results/*.sarif
bench/**/*.sarif

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Go
vendor/
*.prof

# Dependencies that scanners produce
node_modules/
__pycache__/
*.pyc
target/
.gradle/

# Repository bench output (scripts/bench.sh)
bench/

# Mock platform server state (scripts/mock-platform.py)
.mock-platform/

# Internal working documents — business strategy, roadmap and machine-specific
# notes. They stay on disk; they are not part of the published engine.
HANDOFF.md
PLAN.md
docs/platform-ideas.md
docs/plan-plataforma.md

# The engine's own dogfooding state: it changes on every local scan and is not
# part of the published engine. (In a product repository, committing
# .cortex/state.json is the recommended default — that is a per-repo choice.)
/.cortex/state.json
# Backup left by the golangci-lint v1 → v2 migration.
/.golangci.bck.yml

# Deployment credentials generated by scripts/deploy-server.sh. Never commit
# these: .env holds the client API keys and the webhook secret.
/.env
/server.yaml
